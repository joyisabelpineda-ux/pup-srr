# Copy this file to ".env" and edit. NEVER commit .env or put real secrets in this example file.

# development | production
APP_ENV=development

# REQUIRED in production: a long random string (at least 32 characters).
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
# In development, if left empty, a random key is generated and stored in instance/.secret_key
SECRET_KEY=

# Where the SQLite database file lives. Leave empty locally (uses instance/pup_srr.sqlite3).
# On a host with a persistent disk, point this at the disk, e.g. /var/data/pup_srr.sqlite3
PUP_SRR_DB=

# Local server (python app.py)
HOST=127.0.0.1
PORT=5000

# Time zone used for all reservation times
APP_TIMEZONE=Asia/Manila

# Cookies: 1 only when the site is served over HTTPS (automatic when APP_ENV=production)
COOKIE_SECURE=0
# 1 when behind a reverse proxy such as Render/Railway (automatic when APP_ENV=production)
TRUST_PROXY=0
# Optional: public address used inside printed room QR codes, e.g. https://pup-srr.onrender.com
PUBLIC_BASE_URL=

# Allow people to create their own accounts (1 = yes, 0 = administrators only)
ALLOW_REGISTRATION=1

# Local demo data (default ON in development, OFF in production)
SEED_DEMO=1
# Demo accounts (DEMO-STU-001 / DEMO-PROF-001 / DEMO-ADM-001, password DemoPass123!). LOCAL TESTING ONLY.
SEED_DEMO_USERS=1

# First administrator created on startup if it does not exist yet (use these on a public deployment)
ADMIN_USER_ID=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator

# Reservation rules (defaults shown)
RES_MIN_MINUTES=30
RES_MAX_HOURS_STUDENT=4
RES_MAX_HOURS_DEFAULT=8
RES_OPEN_HOUR=6
RES_CLOSE_HOUR=22
RES_MAX_ADVANCE_DAYS=90
RES_MAX_PENDING_PER_USER=10

# Rate limiting for login/registration (defaults shown)
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_SECONDS=900
